# Copy to docker/.env (setup.ps1 does this for you). Use a fast SSD with ~80 GB free:
# models are ~25 GB and every Best capture adds a few GB.
FDA_MODELS=D:/4DGS/models
FDA_DATA=D:/4DGS/data
# Optional: LichtFeld Studio executable for the per-frame SOG scripts in lichtfeld/
# LICHTFELD_EXE=C:/Program Files/LichtFeld-Studio/bin/LichtFeld-Studio.exe
